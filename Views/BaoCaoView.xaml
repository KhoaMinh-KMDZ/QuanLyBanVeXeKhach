<UserControl x:Class="QuanLyBanVeXeKhach.Views.BaoCaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="📊  Báo Cáo Doanh Thu" FontSize="22" FontWeight="Bold"
                   Foreground="#1a2f5a" Margin="0,0,0,20"/>

        <!-- Bộ lọc -->
        <materialDesign:Card Grid.Row="1" Padding="20" UniformCornerRadius="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding TuNgay}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                <TextBlock Grid.Column="2" Text="Đến ngày:" VerticalAlignment="Center" Margin="16,0,10,0" FontSize="14"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding DenNgay}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

                <Button Grid.Column="5" Command="{Binding XemBaoCaoCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#1a2f5a" Foreground="White" BorderThickness="0"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Content="🔍 Xem Báo Cáo" Margin="16,0,8,0" Height="42"/>
                <Button Grid.Column="6" Command="{Binding XuatExcelCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#217346" Foreground="White" BorderThickness="0"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Height="42">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Xuất Excel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- Nội dung báo cáo -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Bảng theo ngày -->
            <materialDesign:Card Grid.Column="0" Padding="0" UniformCornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="#1a2f5a" CornerRadius="12,12,0,0" Padding="16,12">
                        <TextBlock Text="Chi Tiết Theo Ngày" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachNgay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0"
                              RowBackground="White" AlternatingRowBackground="#F8F9FF"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày"        Binding="{Binding NgayText}"      Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Số Vé"       Binding="{Binding SoVe}"          Width="90"  ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Doanh Thu"   Binding="{Binding DoanhThuText}"  Width="*"   ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Tổng kết -->
                    <Border Grid.Row="2" Background="#1a2f5a" CornerRadius="0,0,12,12" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Foreground="White" FontSize="14" FontWeight="Bold">
                                <Run Text="Tổng: "/>
                                <Run Text="{Binding TongSoVe}"/>
                                <Run Text=" vé"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding TongDoanhThuText}"
                                       Foreground="#FFD700" FontSize="16" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- Báo cáo theo tuyến -->
            <materialDesign:Card Grid.Column="2" Padding="0" UniformCornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#2a5298" CornerRadius="12,12,0,0" Padding="16,12">
                        <TextBlock Text="Top Tuyến Xe Doanh Thu" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachTuyen}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0"
                              RowBackground="White" AlternatingRowBackground="#F0F4FF"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tuyến Xe"   Binding="{Binding TenTuyen}"    Width="*"  ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Số Vé"      Binding="{Binding SoVe}"        Width="70" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Doanh Thu"  Binding="{Binding DoanhThuText}" Width="130" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
