<UserControl x:Class="QuanLyBanVeXeKhach.Views.NhanVienView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="👤  Nhân Viên &amp; Phân Quyền" FontSize="22" FontWeight="Bold" Foreground="#1a2f5a" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Width="220" materialDesign:HintAssist.Hint="🔍 Tìm kiếm..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Command="{Binding ThemMoiCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#1a2f5a" Foreground="White" BorderThickness="0"
                    materialDesign:ButtonAssist.CornerRadius="8" Content="+ Thêm NV"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="0" UniformCornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#1a2f5a" CornerRadius="12,12,0,0" Padding="16,10">
                        <TextBlock Text="Danh Sách Nhân Viên" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSach}" SelectedItem="{Binding DuocChon}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0"
                              RowBackground="White" AlternatingRowBackground="#F8F9FF"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ Tên"     Binding="{Binding HoTen}"       Width="*"   ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="SĐT"        Binding="{Binding SDT}"         Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Tài Khoản"  Binding="{Binding TaiKhoan}"    Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Vai Trò"    Binding="{Binding TenVaiTro}"   Width="140" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TrangThaiText, Converter={StaticResource StatusToColorConverter}}"
                                                CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TrangThaiText}" Foreground="White" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,8">
                        <Button Command="{Binding KhoaTKCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#F57C00" BorderBrush="#F57C00" Content="🔒 Khóa TK"/>
                        <Button Command="{Binding MoKhoaTKCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#388E3C" BorderBrush="#388E3C" Content="🔓 Mở Khóa"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="12"
                                 Visibility="{Binding DangSua, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Thông Tin Nhân Viên" FontSize="16" FontWeight="Bold" Foreground="#1a2f5a" Margin="0,0,0,16"/>
                        <TextBox materialDesign:HintAssist.Hint="Họ và tên (*)" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding HoTen}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="SĐT (*)" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding SDT}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="Email" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Email}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="Tài khoản đăng nhập" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding TaiKhoan}" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding DanhSachVaiTro}" SelectedItem="{Binding VaiTroChon}"
                                  DisplayMemberPath="TenVaiTro" materialDesign:HintAssist.Hint="Vai trò (*)"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16"/>

                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="Đặt Mật Khẩu" FontSize="13" FontWeight="Bold" Foreground="#555" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Mật khẩu mới (để trống = không đổi)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding MatKhauMoi}" Margin="0,0,0,12"/>
                        <Button Command="{Binding DoiMatKhauCommand}" Content="Đổi Mật Khẩu Ngay"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#1976D2" BorderBrush="#1976D2" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding HuyFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Content="Hủy" Margin="0,0,10,0"/>
                            <Button Command="{Binding LuuCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#1a2f5a" Foreground="White" BorderThickness="0" Content="💾 Lưu"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
