<Window x:Class="QuanLyBanVeXeKhach.Views.InVeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="In Vé Xe" Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    
    <Border Background="White" Margin="15" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.15" Direction="270" ShadowDepth="5"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Border Background="#1976D2" CornerRadius="12,12,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="VÉ XE KHÁCH" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                    <TextBlock Text="CHÚC QUÝ KHÁCH THƯỢNG LỘ BÌNH AN" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#BBDEFB" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            
            <!-- Body -->
            <Grid Margin="25,20,25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã vé:" VerticalAlignment="Center" Foreground="#757575" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtMaVe" VerticalAlignment="Center" HorizontalAlignment="Right" Text="..." FontWeight="Bold" FontSize="15"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Khách hàng:" VerticalAlignment="Center" Foreground="#757575" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtKhachHang" VerticalAlignment="Center" HorizontalAlignment="Right" Text="..." FontWeight="Bold" FontSize="15"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tuyến xe:" VerticalAlignment="Center" Foreground="#757575" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtTuyenXe" VerticalAlignment="Center" HorizontalAlignment="Right" Text="..." FontWeight="Medium"/>
                
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Giờ xuất bến:" VerticalAlignment="Center" Foreground="#757575" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtXuatBen" VerticalAlignment="Center" HorizontalAlignment="Right" Text="..." FontWeight="Medium"/>
                
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Số ghế:" VerticalAlignment="Center" Foreground="#757575" FontWeight="SemiBold"/>
                <Border Grid.Row="4" Grid.Column="1" Background="#FFEBEE" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,5">
                    <TextBlock x:Name="txtSoGhe" Text="..." FontWeight="Bold" FontSize="20" Foreground="#D32F2F"/>
                </Border>
                
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Giá vé:" VerticalAlignment="Center" Foreground="#757575" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtGiaVe" VerticalAlignment="Center" HorizontalAlignment="Right" Text="..." FontWeight="Bold" Foreground="#388E3C" FontSize="15"/>
                
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Ngày in:" VerticalAlignment="Center" Foreground="#757575" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="txtNgayIn" VerticalAlignment="Center" HorizontalAlignment="Right" Text="..." Foreground="#9E9E9E"/>
            </Grid>

            <!-- Đường xé vé -->
            <Line X1="0" Y1="0" X2="340" Y2="0" Stroke="#E0E0E0" StrokeDashArray="4 4" StrokeThickness="2" HorizontalAlignment="Center"/>
            
            <TextBlock Text="Cảm ơn quý khách đã tin tưởng!" HorizontalAlignment="Center" FontStyle="Italic" Foreground="#9E9E9E" Margin="0,15,0,20"/>

            <!-- Nút bấm -->
            <Button Content="IN BIÊN LAI VÀ ĐÓNG" Click="Close_Click" Style="{StaticResource MaterialDesignRaisedButton}" 
                    Background="#1976D2" BorderBrush="#1976D2" Foreground="White" 
                    Margin="25,0,25,25" Height="45" materialDesign:ButtonAssist.CornerRadius="10" FontSize="14" FontWeight="Bold"/>
        </StackPanel>
    </Border>
</Window>
