<UserControl x:Class="QuanLyBanVeXeKhach.Views.QuanLyVeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="QUẢN LÝ &amp; HỦY VÉ" FontSize="24" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,20"/>

        <!-- Tìm kiếm -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBox Width="250" materialDesign:HintAssist.Hint="Nhập Số Điện Thoại Khách Hàng"
                     Text="{Binding SDTKhachHang, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,15,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding TimKiemCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Tìm Kiếm" Command="{Binding TimKiemCommand}" Width="120" Margin="0,0,15,0"/>
            <Button Content="Hủy Vé Đã Chọn" Command="{Binding HuyVeCommand}" Background="#F44336" BorderBrush="#F44336" Width="150"/>
        </StackPanel>

        <!-- Danh sách -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding DanhSachVe}" SelectedItem="{Binding VeDuocChon}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="All" Background="White" RowHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã Vé" Binding="{Binding MaVe}"/>
                <DataGridTextColumn Header="Khách Hàng" Binding="{Binding TenKhachHang}"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding SDTKhachHang}"/>
                <DataGridTextColumn Header="Tuyến" Binding="{Binding TenTuyen}"/>
                <DataGridTextColumn Header="Xuất Bến" Binding="{Binding ThoiGianXuatBenText}"/>
                <DataGridTextColumn Header="Ghế" Binding="{Binding SoGhe}"/>
                <DataGridTextColumn Header="Giá Vé" Binding="{Binding GiaVe, StringFormat={}{0:N0} đ}"/>
                <DataGridTextColumn Header="Ngày Mua" Binding="{Binding NgayBan, StringFormat=dd/MM/yyyy HH:mm}"/>
                <DataGridTemplateColumn Header="Trạng Thái">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="12,4" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#4CAF50"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrangThai}" Value="2">
                                                <Setter Property="Background" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TrangThaiText}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
