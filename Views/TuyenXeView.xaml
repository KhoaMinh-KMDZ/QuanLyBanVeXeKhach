<UserControl x:Class="QuanLyBanVeXeKhach.Views.TuyenXeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🗺️  Quản Lý Tuyến Xe" FontSize="22" FontWeight="Bold" Foreground="#1a2f5a" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Width="220" materialDesign:HintAssist.Hint="🔍 Tìm kiếm..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Command="{Binding ThemMoiCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#1a2f5a" Foreground="White" BorderThickness="0"
                    materialDesign:ButtonAssist.CornerRadius="8" Content="+ Thêm Tuyến"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="360" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="0" UniformCornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#1a2f5a" CornerRadius="12,12,0,0" Padding="16,10">
                        <TextBlock Text="Danh Sách Tuyến Xe" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSach}" SelectedItem="{Binding DuocChon}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0"
                              RowBackground="White" AlternatingRowBackground="#F8F9FF"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên Tuyến"       Binding="{Binding TenTuyen}"         Width="*"   ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Bến Đi"         Binding="{Binding TenBenDi}"           Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Bến Đến"        Binding="{Binding TenBenDen}"          Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Khoảng Cách (km)" Binding="{Binding KhoangCach}"     Width="130" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Thời Gian"       Binding="{Binding ThoiGianDiChuyen}" Width="110" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TrangThaiText, Converter={StaticResource StatusToColorConverter}}"
                                                CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TrangThaiText}" Foreground="White" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,8">
                        <Button Command="{Binding XoaCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#C62828" BorderBrush="#C62828" Content="🗑 Xóa Tuyến"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="12"
                                 Visibility="{Binding DangSua, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Thông Tin Tuyến Xe" FontSize="16" FontWeight="Bold" Foreground="#1a2f5a" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="Tên tuyến (*)" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding TenTuyen}" Margin="0,0,0,12"/>
                    <ComboBox materialDesign:HintAssist.Hint="Bến đi (*)" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding DanhSachBenXe}" DisplayMemberPath="TenBenXe" SelectedValuePath="MaBenXe"
                              SelectedValue="{Binding MaBenDi}" Margin="0,0,0,12"/>
                    <ComboBox materialDesign:HintAssist.Hint="Bến đến (*)" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding DanhSachBenXe}" DisplayMemberPath="TenBenXe" SelectedValuePath="MaBenXe"
                              SelectedValue="{Binding MaBenDen}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Khoảng cách (km)" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding KhoangCach}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Thời gian di chuyển" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding ThoiGianDiChuyen}" Margin="0,0,0,12"/>
                    <CheckBox Content="Hoạt động" IsChecked="{Binding TrangThai}" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="Ghi chú" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding GhiChu}" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding HuyFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Content="Hủy" Margin="0,0,10,0"/>
                        <Button Command="{Binding LuuCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#1a2f5a" Foreground="White" BorderThickness="0" Content="💾 Lưu"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
