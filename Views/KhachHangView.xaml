<UserControl x:Class="QuanLyBanVeXeKhach.Views.KhachHangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="👥  Quản Lý Khách Hàng" FontSize="22" FontWeight="Bold" Foreground="#1a2f5a" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Width="220" materialDesign:HintAssist.Hint="🔍 Tìm kiếm..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Command="{Binding ThemMoiCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#1a2f5a" Foreground="White" BorderThickness="0"
                    materialDesign:ButtonAssist.CornerRadius="8" Content="+ Thêm Khách"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="0" UniformCornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#1a2f5a" CornerRadius="12,12,0,0" Padding="16,10">
                        <TextBlock Text="Danh Sách Khách Hàng" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSach}" SelectedItem="{Binding DuocChon}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0"
                              RowBackground="White" AlternatingRowBackground="#F8F9FF"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ Tên"    Binding="{Binding HoTen}"      Width="*"   ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="SĐT"       Binding="{Binding SDT}"        Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Email"      Binding="{Binding Email}"      Width="180" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Địa Chỉ"   Binding="{Binding DiaChi}"     Width="180" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="Ngày ĐK"   Binding="{Binding NgayDangKy, StringFormat=\{0:dd/MM/yyyy\}}" Width="100" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,8">
                        <Button Command="{Binding XoaCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#C62828" BorderBrush="#C62828" Content="🗑 Xóa"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="12"
                                 Visibility="{Binding DangSua, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Thông Tin Khách Hàng" FontSize="16" FontWeight="Bold" Foreground="#1a2f5a" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="Họ và tên (*)" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding HoTen}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Số điện thoại (*)" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SDT}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Email" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Email}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Địa chỉ" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DiaChi}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Ghi chú" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding GhiChu}" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding HuyFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Content="Hủy" Margin="0,0,10,0"/>
                        <Button Command="{Binding LuuCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#1a2f5a" Foreground="White" BorderThickness="0" Content="💾 Lưu"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
