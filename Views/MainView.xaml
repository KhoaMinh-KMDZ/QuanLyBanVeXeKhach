<Window x:Class="QuanLyBanVeXeKhach.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:QuanLyBanVeXeKhach.ViewModels"
        xmlns:views="clr-namespace:QuanLyBanVeXeKhach.Views"
        Title="Phần Mềm Quản Lý Bán Vé Xe Khách"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="1000">

    <!-- Mapping ViewModel → View -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TrangChuViewModel}">
            <views:TrangChuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BanVeViewModel}">
            <views:BanVeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuanLyVeViewModel}">
            <views:QuanLyVeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChuyenXeViewModel}">
            <views:ChuyenXeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TuyenXeViewModel}">
            <views:TuyenXeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:XeViewModel}">
            <views:XeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KhachHangViewModel}">
            <views:KhachHangView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NhanVienViewModel}">
            <views:NhanVienView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BaoCaoViewModel}">
            <views:BaoCaoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LichSuGiaoDichViewModel}">
            <views:LichSuGiaoDichView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenXeViewModel}">
            <views:BenXeView/>
        </DataTemplate>

        <!-- Style nút menu sidebar -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0,0,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── SIDEBAR ─────────────────────────────────────── -->
        <Border Grid.Column="0" CornerRadius="0,16,16,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1a2f5a" Offset="0"/>
                    <GradientStop Color="#2a5298" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,28,0,10">
                    <Border Background="#33FFFFFF" CornerRadius="40" Width="72" Height="72">
                        <materialDesign:PackIcon Kind="BusDoubleDecker" Width="44" Height="44"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VÉ XE KHÁCH" Foreground="White" FontSize="16"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Thông tin user -->
                <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="10" Margin="12,0,12,16" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Account" Width="22" Height="22"
                                                 Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ThongTinUser}" Foreground="White" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Menu items -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MenuScrollViewer_PreviewMouseWheel">
                    <StackPanel>
                        <!-- Trang chủ (luôn hiện) -->
                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiTrangChuCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="22" Height="22"
                                                         Foreground="#FFD700" Margin="0,0,14,0"/>
                                <TextBlock Text="Trang Chủ" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Bán Vé -->
                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiBanVeCommand}"
                                Visibility="{Binding CanBanVe, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TicketConfirmation" Width="22" Height="22"
                                                         Foreground="#00E676" Margin="0,0,14,0"/>
                                <TextBlock Text="Bán Vé" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Quản Lý Vé -->
                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiQuanLyVeCommand}"
                                Visibility="{Binding CanBanVe, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel" Width="22" Height="22"
                                                         Foreground="#FF5252" Margin="0,0,14,0"/>
                                <TextBlock Text="Quản Lý Vé" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Lịch Sử Giao Dịch -->
                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiLichSuGiaoDichCommand}"
                                Visibility="{Binding CanBanVe, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="22" Height="22"
                                                         Foreground="#1976D2" Margin="0,0,14,0"/>
                                <TextBlock Text="Lịch Sử Giao Dịch" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Lịch Trình -->
                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiChuyenXeCommand}"
                                Visibility="{Binding CanQuanLyChuyenXe, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="22" Height="22"
                                                         Foreground="#40C4FF" Margin="0,0,14,0"/>
                                <TextBlock Text="Lịch Trình Chuyến Xe" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Danh Mục -->
                        <Separator Background="#33FFFFFF" Margin="16,8"/>
                        <TextBlock Text="DANH MỤC" Foreground="#77FFFFFF" FontSize="11"
                                   FontWeight="Bold" Margin="20,4,0,4"
                                   Visibility="{Binding CanQuanLyDanhMuc, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiTuyenXeCommand}"
                                Visibility="{Binding CanQuanLyDanhMuc, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerPath" Width="22" Height="22"
                                                         Foreground="#FF6D00" Margin="0,0,14,0"/>
                                <TextBlock Text="Tuyến Xe" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiBenXeCommand}"
                                Visibility="{Binding CanQuanLyDanhMuc, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Domain" Width="22" Height="22"
                                                         Foreground="#9C27B0" Margin="0,0,14,0"/>
                                <TextBlock Text="Bến Xe" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiXeCommand}"
                                Visibility="{Binding CanQuanLyDanhMuc, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bus" Width="22" Height="22"
                                                         Foreground="#FF5722" Margin="0,0,14,0"/>
                                <TextBlock Text="Danh Mục Xe" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiKhachHangCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22"
                                                         Foreground="#EA80FC" Margin="0,0,14,0"/>
                                <TextBlock Text="Khách Hàng" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Quản Trị -->
                        <Separator Background="#33FFFFFF" Margin="16,8"
                                   Visibility="{Binding CanQuanLyNhanVien, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="QUẢN TRỊ" Foreground="#77FFFFFF" FontSize="11"
                                   FontWeight="Bold" Margin="20,4,0,4"
                                   Visibility="{Binding CanQuanLyNhanVien, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiNhanVienCommand}"
                                Visibility="{Binding CanQuanLyNhanVien, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BadgeAccountHorizontal" Width="22" Height="22"
                                                         Foreground="#00BCD4" Margin="0,0,14,0"/>
                                <TextBlock Text="Nhân Viên &amp; Phân Quyền" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding HienThiBaoCaoCommand}"
                                Visibility="{Binding CanBaoCao, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="22" Height="22"
                                                         Foreground="#FFC107" Margin="0,0,14,0"/>
                                <TextBlock Text="Báo Cáo Doanh Thu" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Đăng Xuất -->
                <Button Grid.Row="3"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#C0392B" Foreground="White" BorderThickness="0"
                        Height="44" Margin="16,12,16,20"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Command="{Binding DangXuatCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Đăng Xuất" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── NỘI DUNG CHÍNH ───────────────────────────────── -->
        <Border Grid.Column="1" Background="#F0F2F5">
            <ContentControl Content="{Binding CurrentView}" Margin="0"/>
        </Border>
    </Grid>
</Window>
